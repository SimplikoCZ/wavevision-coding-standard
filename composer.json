{
  "name": "simplikocz/coding-standard",
  "description": "The Wavevision PHP coding standard.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Wavevision s.r.o.",
      "email": "info@wavevision.com"
    },
    {
      "name": "Jakub Filla",
      "email": "jakub.filla@wavevision.com"
    },
    {
      "name": "Vít Rozsíval",
      "email": "vit@wavevision.com"
    }
  ],
  "homepage": "https://github.com/wavevision/coding-standard",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require": {
    "php": "^8.4",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpstan/phpstan": "^2.1",
    "slevomat/coding-standard": "^8.0"
  },
  "archive": {
    "exclude": [
      "/.*",
      "/build.xml",
      "/package.json",
      "/phpstan.neon",
      "/phpunit.xml",
      "/prettier.config.js",
      "/scss",
      "/ts",
      "/tsconfig.json",
      "/yarn.lock"
    ]
  }
}
